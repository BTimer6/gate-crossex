# Copy this file to .env and replace every example value before deployment.
# Generate a strong password with: openssl rand -hex 24
GCT_ACCESS_PASSWORD=replace-with-at-least-12-characters

# Recommended: keep the app on loopback and put an HTTPS reverse proxy on the same server.
GCT_PUBLISH_ADDRESS=127.0.0.1
GCT_ALLOWED_HOSTS=trade.example.com
GCT_FRONTEND_ORIGIN=https://trade.example.com
GCT_ACCESS_COOKIE_SECURE=1
